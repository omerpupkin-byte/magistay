# ─── Magistay Backend — Environment Variables ─────────────────
# Copy this file to .env and fill in values for local development.
# In production, set them in Railway → Variables.
# NEVER commit .env to git.

# ── Server ──────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
# Site address(es) allowed to call this server, comma-separated.
# www and non-www are both accepted automatically.
FRONTEND_URL=https://magistay.com

# ── Anthropic (Claude) — matching + AI suggestions ──────────────
ANTHROPIC_API_KEY=your_key_here
# ANTHROPIC_MODEL=claude-sonnet-4-5
# AI_FALLBACK=off        # don't suggest hotels from AI knowledge when a supplier has none

# ── Google Maps Geocoding — turns "Crete" into coordinates ──────
GOOGLE_MAPS_API_KEY=

# ── Hotelbeds — live availability, rates, photos, facilities ────
HOTELBEDS_API_KEY=
HOTELBEDS_API_SECRET=
# HOTELBEDS_ENV=production   # after certification; default is the test environment
# HOTELBEDS_REVIEWS=off      # skip the TripAdvisor rating request

# ── SerpApi — live price per booking platform (Google Hotels) ───
# Without it the site shows the supplier's indicative price only.
SERPAPI_KEY=
# HOTEL_SOURCE=hotelbeds    # use Hotelbeds for candidates instead of Google Hotels
# GOOGLE_HOTELS_PAGES=2     # result pages per new trip (about 20 hotels each, 1 SerpApi search each)
# DISPLAY_CURRENCY=EUR
# PUBLIC_API_URL=           # this server's public address, if it differs from the request host
# LIVE_PRICES=off            # switch live prices off without removing the key

# ── Affiliate ids — defaults are built into src/services/affiliateLinks.js
# Set these only to override them.
# BOOKING_CJ_LINK=https://www.anrdoezrs.net/click-XXXXXXXX-XXXXXXXX
# BOOKING_AFFILIATE_ID=      # direct Booking.com aid; replaces the CJ link when set
# AGODA_AFFILIATE_ID=
# EXPEDIA_AFFCID=
# EXPEDIA_AFFLID=

# ── Not connected yet (waiting for partner approval) ────────────
# BOOKING_API_KEY=           # Booking.com Demand API (Managed Affiliate Partners only)
# BOOKING_API_SECRET=
# EXPEDIA_API_KEY=           # Expedia Rapid API
# EXPEDIA_API_SECRET=

# ── Who earns from each booking platform ────────────────────────
# /health lists the id every platform is using right now. A platform
# listed here gets NO booking button (its price is still shown).
# AFFILIATE_DISABLE=expedia,hotelsCom
#
# Travelpayouts: generate a link for the brand in Travelpayouts and paste
# it here. The hotel's page is put into it as the destination, and the
# platform then goes through Travelpayouts instead of the ids above.
# TP_LINK_BOOKINGCOM=
# TP_LINK_AGODA=
# TP_LINK_EXPEDIA=
# TP_LINK_HOTELSCOM=
# TP_LINK_TRIPCOM=

# ── Shared memory (cuts paid lookups) ───────────────────────────
# With a database, hotel lists and prices already paid for are reused
# across travellers and survive restarts; clicks are stored for good.
# DATABASE_URL=              # Railway: ${{Postgres.DATABASE_URL}}
# PRICE_CACHE_MIN=45         # how long a hotel's prices per site are reused
# LIST_CACHE_HOURS=6         # how long a trip's hotel list is reused
# SERPAPI_COST_PER_CALL=0.015   # for the cost estimate in /health
